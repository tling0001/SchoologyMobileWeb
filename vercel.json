{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": ".",
  "crons": [
    {
      "path": "/api/push/poll",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/push/public-key",
      "destination": "/api/push/subscribe?mode=public-key"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth/session?mode=logout"
    },
    {
      "source": "/api/schoology/assignment-comments",
      "destination": "/api/schoology?action=assignment-comments"
    }
  ]
}
